<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.MongoDB.Driver" Version="9.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="9.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.8" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="9.0.8" PrivateAssets="All" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docuratio.Core\Docuratio.Core.csproj" />
    <ProjectReference Include="..\Docuratio.Models\Docuratio.Models.csproj" />
    <ProjectReference Include="..\Docuratio.ServiceDefaults\Docuratio.ServiceDefaults.csproj" />
  </ItemGroup>

  <Target Name="CopyOpenApiSpec" AfterTargets="GenerateOpenApiDocuments">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/obj/$(MSBuildProjectName).json" DestinationFiles="$(MSBuildProjectDirectory)/../openapi.json" Condition="Exists('$(MSBuildProjectDirectory)/obj/$(MSBuildProjectName).json')" />
  </Target>

</Project>
